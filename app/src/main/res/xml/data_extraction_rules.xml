<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- See backup_rules.xml — DB contains SMS bodies, AI prompts, and
             user context documents. Excluded from both cloud backups and
             device-to-device transfers to protect user privacy. -->
        <exclude domain="database" path="sms_schedule_database" />
        <exclude domain="database" path="sms_schedule_database-shm" />
        <exclude domain="database" path="sms_schedule_database-wal" />
        <exclude domain="sharedpref" path="sms_alarm_times.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="sms_schedule_database" />
        <exclude domain="database" path="sms_schedule_database-shm" />
        <exclude domain="database" path="sms_schedule_database-wal" />
        <exclude domain="sharedpref" path="sms_alarm_times.xml" />
    </device-transfer>
</data-extraction-rules>
